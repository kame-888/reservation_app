<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Reservation App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="bg-dark">
      <div class="container">
        <div class="row align-items-center">
          <div class="col">
            <h1><%= link_to "PoteAccomo", root_path, class: "text-decoration-none" %></h1>
          </div>

          <div class="col-auto">
            <% if current_user %>
              <div class="d-flex align-items-center gap-2">
                <% if current_user.avatar.attached? %>
                  <%= image_tag current_user.avatar, class: "img-fluid rounded-circle", style: "width: 40px; height: 40px;" %>
                <% else %>
                  <%= image_tag "default-avatar.png", class: "img-fluid rounded-circle", style: "width: 40px; height: 40px;" %>
                <% end %>
                <div class="dropdown">
                  <button class="btn btn-outline-secondary dropdown-toggle text-white" type="button"
                    data-bs-toggle="dropdown" aria-expanded="false">
                    <%= current_user.full_name %>
                  </button>
                  <div class="dropdown-menu dropdown-menu-end">
                    <%= link_to "施設の新規登録", new_room_path, class: "dropdown-item" %>
                    <%= link_to "予約一覧", reservations_path, class: "dropdown-item" %>
                    <%= link_to "登録済み施設一覧", rooms_path, class: "dropdown-item" %>
                    <%= link_to "アカウント設定", user_path(current_user), class: "dropdown-item" %>
                    <hr class="dropdown-divider">
                    <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "dropdown-item" %>
                  </div>
                </div>
              </div>          
            <% else %>
              <%= link_to "サインイン", new_user_session_path, class: "text-decoration-none text-info me-2" %>
              <%= link_to "新規登録", new_user_registration_path, class: "btn btn-primary" %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    <div class="container ">
      <%= yield %>
    </div>
  </body>
</html>
