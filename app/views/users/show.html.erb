<% if @user == current_user %>
  <h1 class="h3 mb-4">こんにちは、<%= @user.full_name %>さん</h1>

  <dl class="mb-4">
    <dt>メールアドレス</dt>
    <dd><%= @user.email %></dd>

    <dt class="mt-3">パスワード</dt>
    <dd aria-label="パスワードは設定済みです">＊＊＊＊＊＊＊＊</dd>
  </dl>

  <div class="d-grid gap-2">
    <%= link_to "メール・パスワードの変更", edit_user_registration_path, class: "btn btn-primary" %>
    <%= link_to "名前・アイコンの変更", edit_user_path, class: "btn btn-outline-primary" %>
  </div>
<% else %>
  <h1 class="h3"><%= @user.full_name %>さんのプロフィール</h1>
<% end %>