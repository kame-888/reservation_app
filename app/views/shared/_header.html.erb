<header class="navbar navbar-dark bg-dark">
  <nav class="container">
    <%= link_to "PoteAccomo", root_path, class: "navbar-brand fs-3" %>

    <% if current_user %>
      <div class="d-flex align-items-center gap-2">
        <%= render "shared/avatar", user: current_user %>

        <div class="dropdown">
          <button class="btn btn-outline-light dropdown-toggle" type="button"
                  data-bs-toggle="dropdown" aria-expanded="false">
            <span class="d-none d-md-inline"><%= current_user.full_name %></span>
            <span class="d-md-none visually-hidden"><%= current_user.full_name %></span>
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><%= link_to "予約一覧", reservations_path, class: "dropdown-item" %></li>
            <li><%= link_to "登録済み施設一覧", rooms_path, class: "dropdown-item" %></li>
            <li><%= link_to "施設の新規登録", new_room_path, class: "dropdown-item" %></li>
            <li><%= link_to "アカウント設定", user_path(current_user), class: "dropdown-item" %></li>
            <li><hr class="dropdown-divider"></li>
            <li><%= button_to "ログアウト", destroy_user_session_path, method: :delete,
                              class: "dropdown-item", form: { data: { turbo: false } } %></li>
          </ul>
        </div>
      </div>
    <% else %>
      <div class="d-flex align-items-center gap-2">
        <%= link_to "サインイン", new_user_session_path, class: "link-info text-decoration-none" %>
        <%= link_to "新規登録", new_user_registration_path, class: "btn btn-primary" %>
      </div>
    <% end %>
  </nav>
</header>