<div class="container home-sections d-flex flex-row justify-content-center align-items-center">
  <div class="login-section pt-3">
    <div class="card text-center pt-5 mx-auto" style="width: 23rem;">
      <h1>アカウント情報編集</h1>

      <div class="card-body">
        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <%= render "form", f: f, password_placeholder: "新しいパスワード（変更しない場合は空欄）" %>

          <div class="mb-3">
            <%= f.password_field :current_password, class: "form-control",
                  autocomplete: "current-password", placeholder: "現在のパスワード（必須）" %>
          </div>

          <%= f.submit "更新", class: "btn btn-primary w-100" %>
        <% end %>

        <%= link_to "戻る", user_path(resource), class: "btn btn-link mt-3" %>
      </div>
    </div>
  </div>
</div>