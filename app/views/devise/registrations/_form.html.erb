<div class="mb-3 mt-4">
  <%= f.email_field :email, class: "form-control", placeholder: "電話番号、Eメール" %>
</div>

<div class="mb-3 mt-4">
  <%= f.text_field :first_name, class: "form-control", placeholder: "名前" %>
</div>

<div class="mb-3 mt-4">
  <%= f.text_field :family_name, class: "form-control", placeholder: "苗字" %>
</div>

<div class="mb-3">
  <%= f.password_field :password, class: "form-control", placeholder: password_placeholder %>
</div>

<div class="mb-3">
  <%= f.password_field :password_confirmation, class: "form-control", placeholder: "パスワード確認" %>
</div>

<div class="mb-3">
  <%= f.file_field :avatar, class: "form-control" %>
</div>