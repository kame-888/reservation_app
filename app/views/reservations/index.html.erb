<h1 class="h3 mb-3">予約済み一覧</h1>

<% if @reservations.empty? %>
  <p class="text-center text-muted my-5">予約はまだありません。</p>
<% else %>
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead>
        <tr>
          <th scope="col">画像</th>
          <th scope="col">施設名</th>
          <th scope="col">紹介文</th>
          <th scope="col">金額</th>
          <th scope="col">チェックイン</th>
          <th scope="col">チェックアウト</th>
          <th scope="col">予約確定日時</th>
          <th scope="col"><span class="visually-hidden">操作</span></th>
        </tr>
      </thead>
      <tbody>
        <% @reservations.each do |reservation| %>
          <% room = reservation.room %>
          <tr>
            <td>
              <% if room.image.attached? && room.image.variable? %>
                <%= image_tag room.image,
                              alt: "#{room.name}の写真", loading: "lazy",
                              class: "rounded object-fit-cover", width: 40, height: 40 %>
              <% elsif room.image.attached? %>
                <%= image_tag room.image, alt: "#{room.name}の写真", loading: "lazy",
                              class: "rounded object-fit-cover", width: 40, height: 40 %>
              <% else %>
                <%= image_tag "default-image.png", alt: "写真は未登録です", loading: "lazy",
                              class: "rounded object-fit-cover", width: 40, height: 40 %>
              <% end %>
            </td>
            <td><%= link_to room.name, room_path(room) %></td>
            <td><%= truncate(room.description, length: 40) %></td>
            <td class="text-nowrap">
              <%= number_to_currency(reservation.total, unit: "円", format: "%n%u", precision: 0) %>
            </td>
            <td class="text-nowrap"><%= reservation.checkin_at.strftime("%Y/%m/%d") %></td>
            <td class="text-nowrap"><%= reservation.checkout_at.strftime("%Y/%m/%d") %></td>
            <td class="text-nowrap"><%= reservation.created_at.strftime("%Y/%m/%d %H:%M") %></td>
            <td>
              <%= link_to "キャンセル", reservation,
                          data: { turbo_method: :delete, turbo_confirm: "予約をキャンセルしますか？" },
                          class: "btn btn-sm btn-outline-danger" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>