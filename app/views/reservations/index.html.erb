<h3>予約済み一覧</h3>

<table class="table">
  <tr>
    <th>画像</th>
    <th>施設名</th>
    <th>紹介文</th>
    <th>金額</th>
    <th>チェックイン</th>
    <th>チェックアウト</th>
    <th>予約確定日時</th>
  </tr>
  <% @reservations.each do |reservation| %>
    <% room = reservation.room %>
    <tr>
      <td>
        <% if room.image.attached? %>
          <%= image_tag room.image %>
        <% else %>
        <% end %>
      </td>
      <td><%= room.name %></td>
      <td><%= room.description %></td>
      <td><%= reservation.total %></td>
      <td><%= reservation.checkin_at %></td>
      <td><%= reservation.checkout_at %></td>
      <td><%= reservation.created_at.strftime("%Y/%m/%d %H:%M") %></td>
      <td><%= link_to "削除", reservation, data: { turbo_method: :delete, turbo_confirm: "予約を削除しますか？" }, class: "btn btn-danger" %></td>
    </tr>
  <% end %>
</table>