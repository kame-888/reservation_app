<% areas = [
  { name: "東京",   keyword: "東京都", image: "tokyo_image.jpg" },
  { name: "大阪",   keyword: "大阪府", image: "osaka_image.jpg" },
  { name: "京都",   keyword: "京都府", image: "kyoto_image.jpg" },
  { name: "北海道", keyword: "北海道", image: "hokkaido_image.jpg" }
] %>

<section class="card text-white border-0 rounded-0 hero">
  <%= image_tag "home_image.jpg", alt: "", class: "card-img rounded-0 hero-img" %>
  <div class="card-img-overlay hero-overlay d-flex">
    <div class="m-auto w-100 px-3" style="max-width: 600px;">
      <h1 class="card-title text-center mb-4">今日はここに、明日はそこに</h1>

      <%= form_with url: home_search_path, method: :get do %>
        <%= label_tag :keyword, "エリア名", class: "visually-hidden" %>
        <%= text_field_tag :keyword, params[:keyword],
                           placeholder: "エリア名で検索", class: "form-control mb-2" %>

        <%= label_tag :free_word, "フリーワード", class: "visually-hidden" %>
        <%= text_field_tag :free_word, params[:free_word],
                           placeholder: "フリーワード検索", class: "form-control" %>

        <div class="d-grid col-md-6 mx-auto mt-3">
          <%= submit_tag "検索", class: "btn btn-success btn-lg text-white" %>
        </div>
      <% end %>
    </div>
  </div>
</section>

<section class="container my-5">
  <h2 class="h4 mb-3">人気のエリア</h2>
  <div class="row g-3">
    <% areas.each do |area| %>
      <div class="col-6 col-md-3">
        <%= link_to home_search_path(keyword: area[:keyword]), class: "text-decoration-none text-body" do %>
          <%= image_tag area[:image], alt: "", loading: "lazy", class: "img-fluid rounded city-img mb-2" %>
          <h3 class="h5"><%= area[:name] %></h3>
        <% end %>
      </div>
    <% end %>
  </div>
</section>