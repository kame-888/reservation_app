<% if @rooms.empty? %>
  <p class="text-center text-muted my-5">条件に合う施設が見つかりませんでした。</p>
<% else %>
  <div class="row g-4">
    <% @rooms.each do |room| %>
      <div class="col-md-6 col-lg-4">
        <article class="card h-100">

          <% if room.image.attached? && room.image.variable? %>
            <%= image_tag room.image.variant(resize_to_fill: [800, 600], format: :jpeg),
                          alt: "#{room.name}の写真", loading: "lazy",
                          class: "card-img-top room-card-img" %>
          <% elsif room.image.attached? %>
            <%= image_tag room.image, alt: "#{room.name}の写真", loading: "lazy",
                          class: "card-img-top room-card-img" %>
          <% else %>
            <%= image_tag "default-image.png", alt: "写真は未登録です", loading: "lazy",
                          class: "card-img-top room-card-img" %>
          <% end %>

          <div class="card-body">
            <h2 class="h4 card-title text-center border-bottom pb-2"><%= room.name %></h2>

            <dl class="mb-0">
              <dt>紹介文</dt>
              <dd class="room-card-description">
                <%= simple_format(truncate(room.description, length: 80)) %>
              </dd>

              <dt class="mt-3">住所</dt>
              <dd class="text-center fs-5"><%= room.address %></dd>

              <dt class="mt-3">金額</dt>
              <dd class="text-center fs-5 mb-0">
                <%= number_to_currency(room.price, unit: "円", format: "%n%u", precision: 0) %>〜
              </dd>
            </dl>
          </div>

          <div class="card-footer text-center bg-transparent border-0 pb-3">
            <% if current_user %>
              <%= link_to "予約に進む", room, class: "btn btn-info btn-lg" %>
            <% else %>
              <%= link_to "サインインして予約", new_user_session_path, class: "btn btn-info btn-lg" %>
            <% end %>
          </div>

        </article>
      </div>
    <% end %>
  </div>
<% end %>