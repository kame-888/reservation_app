 <%= flash[:notice] %>

<div class="row">
  <div class="col-xs-8">
    <h3>宿泊施設一覧</h3>
  </div>
  <div class="col-xs-4 text-right">
    <%= link_to "新規登録", new_room_path, class: "btn btn-primary" %>
  </div>
</div>
<table class="table">
  <tr>
    <th>施設画像</th><th>施設名</th><th>詳細</th><th>宿泊料金</th><th>作成日</th>
  </tr>
  <% @rooms.each do |room| %>
    <tr>
      <td>
        <% if room.image.attached? %>
          <%= image_tag room.image, class: "img-fluid", style: "width: 40px; height: 40px;" %>
        <% else %>
          <%= image_tag "default-image.png", class: "img-fluid", style: "width: 40px; height: 40px;" %>
        <% end %>
      </td>
      <td>
        <%= link_to room.name, room_path(room), class: "text-decoration-none" %>
      </td>
      <td>
        <%= room.description %>
      </td>
      <td>
        <%= room.price %>
      </td>
      <td>
        <%= room.created_at.strftime("%Y/%m/%d") %>
      </td>
      <td>
        <%= link_to "編集", edit_room_path(room), class:"btn btn-secondary" %>
      </td>
      <td>
        <%= link_to "削除", room, data: {turbo_method: :delete, turbo_confirm: "宿泊施設を削除しますか？"}, class:"btn btn-danger" %>
      </td>
    </tr>
  <% end %>
</table>