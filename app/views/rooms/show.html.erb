<div class="row">
  <div class="col-md-8 offset-md-2">

    <% if @room.image.attached? %>
      <div class="text-center mb-4">
        <%= image_tag @room.image, class: "img-fluid rounded" %>
      </div>
    <% end %>

    <div class="text-center border-bottom pb-2 mb-4">
      <h2><%= @room.name %></h2>
    </div>

    <div class="card mb-3">
      <div class="card-header fw-bold">紹介文</div>
      <div class="card-body fs-5" style="min-height: 60px;">
        <%= simple_format(@room.description) %>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-header fw-bold">住所</div>
      <div class="card-body text-center">
        <h3 class="mb-0"><%= @room.address %></h3>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-header fw-bold">金額</div>
      <div class="card-body text-center">
        <h3 class="mb-0"><%= number_to_currency(@room.price, unit: "円", format: "%n%u", precision: 0) %></h3>
      </div>
    </div>
    
    <%= form_with model: @reservation, url: confirm_room_reservations_path(@room), method: :post,  data: { turbo: false } do |f| %>
      <%# エラーメッセージ表示 %>
      <% if @reservation.errors.any? %>
        <ul class="errors">
          <% @reservation.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      <% end %>
      
      <div class="form-group">
        <%= f.label :checkin_at, "チェックイン", class:"control-label" %>
        <%= f.date_field :checkin_at, class:"form-control" %>
      </div>
      <div class="form-group">
        <%= f.label :checkout_at, "チェックアウト", class:"control-label" %>
        <%= f.date_field :checkout_at, class:"form-control" %>
      </div>
      <div class="form-group">
        <%= f.label :name, "人数", class:"control-label" %>
        <%= f.number_field :guest_count, class:"form-control" %>
      </div>
      <%= f.submit "確認画面へ", class:"btn btn-success" %>
    <% end %>
  </div>
</div>