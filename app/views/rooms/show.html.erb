<div class="row">
  <div class="col-md-8 offset-md-2">

    <% if @room.image.attached? %>
      <div class="text-center mb-4">
        <%= image_tag @room.image, class: "img-fluid rounded" %>
      </div>
    <% end %>

    <div class="text-center border-bottom pb-2 mb-4">
      <h2><%= @room.name %></h2>
    </div>

    <div class="card mb-3">
      <div class="card-header fw-bold">紹介文</div>
      <div class="card-body fs-5" style="min-height: 60px;">
        <%= simple_format(@room.description) %>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-header fw-bold">住所</div>
      <div class="card-body text-center">
        <h3 class="mb-0"><%= @room.address %></h3>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-header fw-bold">金額</div>
      <div class="card-body text-center">
        <h3 class="mb-0"><%= number_to_currency(@room.price, unit: "円", format: "%n%u", precision: 0) %></h3>
      </div>
    </div>
    
    <% if current_user %>
      <div class="text-center my-4">
        <%= link_to "編集", edit_room_path(@room), class: "btn btn-info btn-lg" %>
        <%= link_to "削除", @room, data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "btn btn-danger btn-lg" %>
        <%= link_to "一覧へ戻る", :back, class: "btn btn-secondary btn-lg" %>
      </div>
    <% else %>
      <%= form_with model: @reservation, url: confirm_room_reservations_path(@room), method: :post do |f| %>
        <div class="form-group">
          <%= form.label :checkin_at, "チェックイン", class:"control-label" %>
          <%= form.date_field :checkin_at, class:"form-control" %>
        </div>
        <div class="form-group">
          <%= form.label :checkout_at, "チェックアウト", class:"control-label" %>
          <%= form.date_field :checkout_at, class:"form-control" %>
        </div>
        <div class="form-group">
          <%= form.label :name, "人数", class:"control-label" %>
          <%= form.number_field :guest_count, class:"form-control" %>
        </div>
        <%= form.submit "確認画面へ", class:"btn btn-success" %>
      <% end %>

    <% end %>

  </div>
</div>